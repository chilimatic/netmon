# netmond: netmon's monitor and firewall daemon.
# Install: see README.md, "Install as a service".
# Options (--ask, --rules PATH, --interval-ms): sudo systemctl edit netmond
#   [Service]
#   ExecStart=
#   ExecStart=/usr/local/bin/netmond --ask

[Unit]
Description=netmon network monitor and firewall
# Rules are in force before the network comes up.
Wants=network-pre.target
Before=network-pre.target
# Links are pinned here so rules survive a crash.
RequiresMountsFor=/sys/fs/bpf

[Service]
Type=simple
ExecStart=/usr/local/bin/netmond
# Reads the host block lists again; the rules stay.
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM is a clean stop: netmond removes its pins and rules. A crash
# leaves them in force; the restart replaces them with the rules file.
Restart=on-failure
RestartSec=2
# 78: the rules file has an error. A restart would fail the same way.
RestartPreventExitStatus=78
# netmond loads eBPF programs and reads every process's sockets: it runs
# as root, but with only the capabilities it needs:
#   CAP_BPF, CAP_PERFMON     load programs, attach tracepoints
#   CAP_NET_ADMIN            TC and cgroup attach, netlink
#   CAP_SYS_PTRACE           read /proc/<pid>/fd, exe and net of others
#   CAP_DAC_READ_SEARCH      read /proc and tracefs files of other users
#   CAP_SYS_RESOURCE         locked memory for maps on kernels < 5.11
#   CAP_CHOWN, CAP_FOWNER    give the socket and the connection log to group netmon
# Kernels before 5.8 have no CAP_BPF: add CAP_SYS_ADMIN there.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SYS_RESOURCE CAP_CHOWN CAP_FOWNER
NoNewPrivileges=yes
# It writes only the socket in /run, its pins, /etc/netmon (s in the
# Rules tab saves there) and the connection log in /var/log/netmon.
ProtectSystem=strict
ReadWritePaths=/run /sys/fs/bpf -/etc/netmon
LogsDirectory=netmon
LogsDirectoryMode=0755
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf perf_event_open
SystemCallErrorNumber=EPERM
# Snapshots for 16 UIs with 30 000 flows stay far below this.
MemoryMax=1G
# Two threads per UI, plus the main, accept and container threads.
TasksMax=64

[Install]
WantedBy=multi-user.target
